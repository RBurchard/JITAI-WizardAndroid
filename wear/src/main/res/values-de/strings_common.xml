<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings shared across several watch screens, plus the settings menu.

  Android merges every file in res/values/, so each UI area keeps its own strings_*.xml.
  Keys defined HERE must not be redefined elsewhere — duplicate resource names fail the build.

  Keep watch copy SHORT. It has to fit a 1.2" screen at the smallest supported size; see
  ui/layout/WearDimens.kt. German and Dutch run noticeably longer than English, so prefer a
  clipped-but-clear word over a full sentence.
-->
<resources>

    <!-- ── Generic actions ──────────────────────────────────────────────────── -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Abbrechen</string>
    <string name="common_back">Zurück</string>
    <string name="common_close">Schließen</string>

    <!-- ── Settings menu ────────────────────────────────────────────────────── -->
    <string name="settings_title">Einstellungen</string>
    <string name="settings_open">Einstellungen</string>
    <string name="settings_language">Sprache</string>
    <!-- Picker entry that hands the choice back to the watch's own language setting. -->
    <string name="settings_language_system">System</string>
    <!-- Moved into Settings so the main screen is not cramped on small watches. -->
    <string name="settings_force_end">Beenden erzwingen</string>
    <string name="settings_force_end_confirm">App schließen und Aufzeichnung stoppen?</string>


    <!-- ── Mini-game tuning + free play (ui/settings/SettingsScreen.kt) ─────── -->
    <string name="settings_games">Minispiele</string>
    <string name="settings_simon_speed">Simon-Tempo</string>
    <string name="settings_simon_rounds">Simon-Runden</string>
    <string name="settings_value_of">%1$d/%2$d</string>
    <string name="settings_practice">Üben</string>
    <string name="settings_practice_hint">Freies Spiel. Nichts wird erfasst.</string>


    <!-- Lock-picking tuning: sensitivity/run length, and what a slip costs. -->
    <string name="settings_lock_difficulty">Schloss-Stufe</string>
    <string name="settings_lock_penalty">Strafe bei Fehler</string>
    <string name="settings_lock_penalty_stun">Betäuben</string>
    <string name="settings_lock_penalty_pushback">Zurückwerfen</string>
    <string name="settings_lock_penalty_reset">Stufe neu</string>

</resources>
