<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings shared across several watch screens, plus the settings menu.

  Android merges every file in res/values/, so each UI area keeps its own strings_*.xml.
  Keys defined HERE must not be redefined elsewhere — duplicate resource names fail the build.

  Keep watch copy SHORT. It has to fit a 1.2" screen at the smallest supported size; see
  ui/layout/WearDimens.kt. German and Dutch run noticeably longer than English, so prefer a
  clipped-but-clear word over a full sentence.
-->
<resources>

    <!-- ── Generic actions ──────────────────────────────────────────────────── -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Annuleren</string>
    <string name="common_back">Terug</string>
    <string name="common_close">Sluiten</string>

    <!-- ── Settings menu ────────────────────────────────────────────────────── -->
    <string name="settings_title">Instellingen</string>
    <string name="settings_open">Instellingen</string>
    <string name="settings_language">Taal</string>
    <!-- Picker entry that hands the choice back to the watch's own language setting. -->
    <string name="settings_language_system">Systeem</string>
    <!-- Moved into Settings so the main screen is not cramped on small watches. -->
    <string name="settings_force_end">Geforceerd stoppen</string>
    <string name="settings_force_end_confirm">App sluiten en registratie stoppen?</string>


    <!-- ── Mini-game tuning + free play (ui/settings/SettingsScreen.kt) ─────── -->
    <string name="settings_games">Minigames</string>
    <string name="settings_simon_speed">Simon-tempo</string>
    <string name="settings_simon_rounds">Simon-rondes</string>
    <string name="settings_value_of">%1$d/%2$d</string>
    <string name="settings_practice">Oefenen</string>
    <string name="settings_practice_hint">Vrij spelen. Er wordt niets vastgelegd.</string>


    <!-- Lock-picking tuning: sensitivity/run length, and what a slip costs. -->
    <string name="settings_lock_difficulty">Slot-niveau</string>
    <string name="settings_lock_penalty">Straf bij fout</string>
    <string name="settings_lock_penalty_stun">Verdoven</string>
    <string name="settings_lock_penalty_pushback">Terugzetten</string>
    <string name="settings_lock_penalty_reset">Fase opnieuw</string>

</resources>
