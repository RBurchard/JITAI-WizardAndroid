    <string name="game_settings_watch_out_of_sync">Uhr hat noch nicht bestätigt</string>
    <string name="game_settings_watch_never_acked">Noch keine Bestätigung von der Uhr</string>
    <string name="game_settings_resend">Erneut senden</string>
    <string name="game_simonsays_title">Simon sagt</string>
    <string name="game_lockpicking_title">Schlossknacken</string>
    <string name="settings_simon_speed">Tempo</string>
