<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings shared across several phone screens, plus the language picker.

  Android merges every file in res/values/, so each UI area keeps its own strings_*.xml.
  Keys defined HERE must not be redefined elsewhere — duplicate resource names fail the build.

  ADDING A LANGUAGE: copy each strings*.xml into res/values-<tag>/ and translate the values.
  See convention/.../locale/LocaleController.kt for the full checklist.
-->
<resources>

    <!-- ── Generic actions, reused across screens ───────────────────────────── -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Annuleren</string>
    <string name="common_save">Opslaan</string>
    <string name="common_delete">Verwijderen</string>
    <string name="common_back">Terug</string>
    <string name="common_done">Klaar</string>
    <string name="common_close">Sluiten</string>
    <!-- Shown in dropdowns for "nothing selected". Display only — never compared in code. -->
    <string name="common_none">Geen</string>

    <!-- ── Settings & language picker ───────────────────────────────────────── -->
    <string name="settings_title">Instellingen</string>
    <string name="settings_language">Taal</string>
    <string name="settings_language_description">Kies de taal die in de hele app wordt gebruikt.</string>
    <!-- Picker entry that hands the choice back to the phone's own language setting. -->
    <string name="settings_language_system">Systeemstandaard</string>
    <string name="settings_language_current">Huidig: %1$s</string>
    <string name="settings_about">Over</string>
    <string name="settings_version">Versie %1$s</string>

</resources>
