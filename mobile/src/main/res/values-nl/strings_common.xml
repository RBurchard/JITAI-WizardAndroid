<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings shared across several phone screens, plus the language picker.

  Android merges every file in res/values/, so each UI area keeps its own strings_*.xml.
  Keys defined HERE must not be redefined elsewhere — duplicate resource names fail the build.

  ADDING A LANGUAGE: copy each strings*.xml into res/values-<tag>/ and translate the values.
  See convention/.../locale/LocaleController.kt for the full checklist.
-->
<resources>

    <!-- ── Generic actions, reused across screens ───────────────────────────── -->
    <string name="common_ok">OK</string>
    <string name="common_cancel">Annuleren</string>
    <string name="common_save">Opslaan</string>
    <string name="common_delete">Verwijderen</string>
    <string name="common_back">Terug</string>
    <string name="common_done">Klaar</string>
    <string name="common_close">Sluiten</string>
    <!-- Shown in dropdowns for "nothing selected". Display only — never compared in code. -->
    <string name="common_none">Geen</string>

    <!-- ── Settings & language picker ───────────────────────────────────────── -->
    <string name="settings_title">Instellingen</string>
    <string name="settings_language">Taal</string>
    <string name="settings_language_description">Kies de taal die in de hele app wordt gebruikt.</string>
    <!-- Picker entry that hands the choice back to the phone's own language setting. -->
    <string name="settings_language_system">Systeemstandaard</string>
    <string name="settings_language_current">Huidig: %1$s</string>
    <string name="settings_about">Over</string>
    <string name="settings_version">Versie %1$s</string>


    <!-- Watch mini-game difficulty, edited from the phone (ui/settings/GameSettingsScreen.kt). -->
    <string name="settings_watch_section">Horloge</string>
    <string name="game_settings_title">Minigame-moeilijkheid</string>
    <string name="game_settings_subtitle">Stel de horlogegames in voor deze deelnemer</string>
    <string name="game_settings_scope">Opgeslagen in schema: %1$s</string>
    <string name="game_settings_footer">Deze instellingen worden bij het experimentschema bewaard, naar het horloge gestuurd en vastgelegd in het sessielog en de CSV-export.</string>
    <string name="game_settings_watch_in_sync">Horloge is synchroon</string>
    <string name="game_settings_watch_out_of_sync">Horloge heeft dit nog niet bevestigd</string>
    <string name="game_settings_watch_never_acked">Nog geen bevestiging van het horloge</string>
    <string name="game_settings_resend">Opnieuw sturen</string>
    <string name="game_simonsays_title">Simon Zegt</string>
    <string name="game_lockpicking_title">Slot kraken</string>
    <string name="settings_simon_speed">Tempo</string>
    <string name="settings_simon_speed_description">Hoe snel de reeks oplicht. De tijd om na te tikken wordt nooit korter.</string>
    <string name="settings_simon_rounds">Rondes</string>
    <string name="settings_simon_rounds_description">Hoeveel rondes gehaald moeten worden.</string>
    <string name="settings_lock_difficulty">Moeilijkheid</string>
    <string name="settings_lock_difficulty_description">Hoe stil de pols moet blijven en hoe lang de stralengang is.</string>
