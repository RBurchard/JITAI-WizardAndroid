<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages this app ships. Android 13+ reads this to build the per-app language
  entry under Settings > Apps > JITAI Companion > Language.

  ADDING A LANGUAGE: add res/values-<tag>/strings.xml, then add one <locale> line here
  and one entry to AppLanguages.SUPPORTED in locale/LocaleController.kt.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="nl" />
</locale-config>
